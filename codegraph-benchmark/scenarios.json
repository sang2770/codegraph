  "scenarios": [
    {
      "id": "ex-a1-request-flow",
      "repo": "express",
      "type": "analysis",
      "kind": "flow",
      "prompt": "How does an incoming HTTP request travel from the Express app function to the router and, when nothing handles it, to the final 404/error handler? Name the functions involved in order.",
      "expect": [["app.handle", "handle("], ["router.handle", "this.router"], ["finalhandler"], ["createApplication"]]
    },
    {
      "id": "ex-a2-res-json",
      "repo": "express",
      "type": "analysis",
      "kind": "flow",
      "prompt": "Trace what happens when a route calls res.json(obj): how is the body serialized, how are Content-Type, Content-Length and ETag decided, and where is the response finally written?",
      "expect": [["stringify"], ["res.send", "send("], ["etag fn", "etagFn", "generateETag"], ["setCharset"], ["json escape", "escape"]]
    },
    {
      "id": "ex-a3-trust-proxy-impact",
      "repo": "express",
      "type": "analysis",
      "kind": "impact",
      "prompt": "If the behavior of compileTrust changes, which request properties and code paths are affected? List every consumer of the compiled 'trust proxy' function.",
      "expect": [["trust proxy fn"], ["req.ip", "'ip'", " ip "], ["ips"], ["protocol"], ["hostname", "host"]]
    },
    {
      "id": "ex-a4-render",
      "repo": "express",
      "type": "analysis",
      "kind": "architecture",
      "prompt": "Explain how res.render resolves a template file and invokes the template engine. Which classes/functions participate and how is the engine chosen?",
      "expect": [["app.render"], ["View"], ["lookup"], ["tryRender"], ["engine"]]
    },
    {
      "id": "ex-r1-trust-offbyone",
      "repo": "express",
      "type": "review",
      "kind": "seeded-security",
      "seed": [{ "file": "lib/utils.js", "find": "return function(a, i){ return i < val };", "replace": "return function(a, i){ return i <= val };" }],
      "expect": [["compileTrust"], ["off-by-one", "<=", "one extra", "additional hop", "extra hop"], ["X-Forwarded-For", "spoof"], ["req.ip", "ip"]],
      "detect": [["compileTrust", "trust proxy"], ["<=", "off-by-one", "one extra", "extra hop", "additional hop"]]
    },
    {
      "id": "ex-r2-json-escape",
      "repo": "express",
      "type": "review",
      "kind": "seeded-security",
      "seed": [{ "file": "lib/response.js", "find": "json = json.replace(/[<>&]/g, function (c) {", "replace": "json = json.replace(/[<&]/g, function (c) {" }],
      "expect": [["stringify"], [">", "\\u003e", "greater-than"], ["jsonp"], ["json escape", "XSS"]],
      "detect": [["stringify", "json escape", "escape"], [">", "\\u003e", "greater"]]
    },
    {
      "id": "ex-r3-etag-default",
      "repo": "express",
      "type": "review",

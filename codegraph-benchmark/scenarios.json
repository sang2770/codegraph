      "seed": [{ "file": "lib/utils.js", "find": "    case true:\n    case 'weak':\n      fn = exports.wetag;\n      break;", "replace": "    case true:\n      fn = exports.wetag;\n      break;\n    case 'weak':\n      fn = exports.etag;\n      break;" }],
      "expect": [["compileETag"], ["defaultConfiguration", "default"], ["strong"], ["res.send", "send"]],
      "detect": [["weak"], ["strong", "exports.etag"]]
